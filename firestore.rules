rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // — Family whitelist —
    // Find UIDs: Firebase Console → Build → Authentication → Users → copy UID
    // Steps:
    //   1. Go to https://console.firebase.google.com/project/relocation-map-30570
    //   2. Build → Authentication → Users
    //   3. Copy the UID for each signed-in family member
    //   4. Paste below, one per line
    //   5. Run ./deploy.sh to push the new rules
    function isFamily() {
      return request.auth != null && request.auth.uid in [
        'IiNjEBzA2LQyMUUeMs7vxvRrp992', // Kevin
        'rFg6XxmOVPTidhXCMLuV9n8P0GG3', // Noi
        // 'REPLACE_WITH_SON_UID',
      ];
    }

    match /{col}/{id} {
      // Any family member can read all family data
      allow read:   if isFamily();

      // Only the document owner can create (prevents spoofing another user's id)
      allow create: if isFamily()
                    && request.auth.uid == request.resource.data.userId;

      // Any family member can update (e.g. edit a note created by someone else)
      allow update: if isFamily();

      // Any family member can delete
      allow delete: if isFamily();
    }
  }
}
